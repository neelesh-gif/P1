# LocalChat Configuration
# Server Port (Default: 3000)
PORT=3000

# Server Host Binding (0.0.0.0 listens on all interfaces / LAN)
HOST=0.0.0.0

# Master Admin Key (leave blank to auto-generate a secure random key on startup)
ADMIN_KEY=

# Persistence Mode: ':memory:' (pure in-memory, instant wipe on exit) or 'file' (stored in data/localchat.db)
DB_MODE=:memory:

# Auto-wipe data directory and uploads on shutdown
AUTO_WIPE_ON_SHUTDOWN=true

# Max file upload size in MB (Default: 10)
MAX_FILE_SIZE_MB=10

# Default Invite Token Expiry in minutes (0 for unlimited, default: 60)
DEFAULT_TOKEN_EXPIRY_MINUTES=60
